# ── Konfigurace prostředí pro hru SLOVO. (Český Contexto Multiplayer) ──

# Port, na kterém server naslouchá (Render i VPS dosadí automaticky nebo použije 3000)
PORT=3000

# Režim prostředí: 'development' nebo 'production'
NODE_ENV=production

# Tajný token pro administrátorská práva (v aréně se aktivuje v chatu příkazem !admin <heslo>)
# DŮLEŽITÉ: Na produkci nikdy nepoužívejte výchozí token! Vygenerujte silný náhodný řetězec.
ADMIN_SECRET=zmente_toto_tajne_heslo_pred_spustenim_12345

# Volitelný oficiální Google YouTube Data API v3 klíč
# Získat lze zdarma v Google Cloud Console (limit 10 000 jednotek denně).
# Pokud není zadán, vyhledávání skladeb používá webový dotaz a přímé YouTube odkazy.
YOUTUBE_API_KEY=

# Kontaktní a DSA e-mail pro hlášení obsahu
CONTACT_EMAIL=slovotecka@proton.me

# Render PostgreSQL / PostgreSQL na VPS. Na Renderu zkopírujte Internal Database URL.
DATABASE_URL=

# Volitelné nastavení SSL pro PostgreSQL ('true', 'false' nebo automaticky dle URL a prostředí)
DB_SSL=

# Volitelná cesta k důvěryhodnému CA certifikátu databáze (PEM). TLS ověření se nevypíná.
DB_SSL_CA_FILE=

# IP dalších důvěryhodných reverzních proxy, oddělené čárkou. Loopback je důvěryhodný automaticky.
TRUST_PROXY_IPS=

# Náhodný dlouhý secret pro přihlášení a guest cookie; nastavte i pro zachování guest her po restartu.
SESSION_SECRET=

# Seznam přezdívek registrovaných hráčů, kteří mají automaticky admin práva (oddělené čárkou, např. "Lukas,Admin")
ADMIN_USERNAMES=
