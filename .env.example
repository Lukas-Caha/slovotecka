# ── Konfigurace prostředí pro hru SLOVO. (Český Contexto Multiplayer) ──

# Port, na kterém server naslouchá (Render i VPS dosadí automaticky nebo použije 3000)
PORT=3000

# Režim prostředí: 'development' nebo 'production'
NODE_ENV=production

# Tajný token pro administrátorská práva (v aréně se zadává k přezdívce např. "Admin /moje-tajne-heslo-xyz")
# DŮLEŽITÉ: Na produkci nikdy nepoužívejte výchozí token! Vygenerujte silný náhodný řetězec.
ADMIN_SECRET=zmente_toto_tajne_heslo_pred_spustenim_12345

# Volitelný oficiální Google YouTube Data API v3 klíč
# Získat lze zdarma v Google Cloud Console (limit 10 000 jednotek denně).
# Pokud není zadán, vyhledávání skladeb používá webový dotaz a přímé YouTube odkazy.
YOUTUBE_API_KEY=

# Kontaktní a DSA e-mail pro hlášení obsahu
CONTACT_EMAIL=slovotecka@proton.me
